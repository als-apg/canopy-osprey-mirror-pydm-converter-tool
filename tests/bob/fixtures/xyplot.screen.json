{
  "schemaVersion": "1.0",
  "kind": "screen",
  "id": "xyplot",
  "metadata": {
    "title": "xyplot",
    "source": {
      "type": "bob-converter"
    },
    "size": {
      "width": 800,
      "height": 600
    }
  },
  "macros": [
    {
      "name": "BPM",
      "default": ""
    },
    {
      "name": "BPM_X",
      "default": ""
    },
    {
      "name": "BPM_Y",
      "default": ""
    },
    {
      "name": "UNIT",
      "default": ""
    }
  ],
  "root": {
    "id": "w-001",
    "type": "absolute-canvas",
    "props": {
      "width": 800,
      "height": 600,
      "backgroundColor": "#ffffff"
    },
    "geometry": {
      "x": 0,
      "y": 0,
      "width": 800,
      "height": 600
    },
    "children": [
      {
        "id": "w-002",
        "type": "waveform-plot",
        "props": {
          "title": "Orbit",
          "curves": [
            {
              "name": "${BPM} orbit",
              "x_channel": "${BPM_X}",
              "y_channel": "${BPM_Y}",
              "color": "#0000ff",
              "lineWidth": 2
            }
          ],
          "yAxes": [
            {
              "name": "y0",
              "label": "mm"
            },
            {
              "name": "y1",
              "label": "${UNIT}"
            }
          ]
        },
        "geometry": {
          "x": 0,
          "y": 0,
          "width": 400,
          "height": 300
        }
      }
    ]
  }
}
